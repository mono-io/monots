# CI packaging image: build monots-server + monots for the *container*
# architecture. Used with `docker buildx --platform …` so armv7 / riscv64
# etc. compile natively under QEMU (required for librdkafka cmake).

ARG RUST_VERSION=1.94.1
ARG DEBIAN_VERSION=bookworm

FROM rust:${RUST_VERSION}-${DEBIAN_VERSION} AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        pkg-config \
        libssl-dev \
        libsasl2-dev \
        libcurl4-openssl-dev \
        protobuf-compiler \
        zip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY . .

ENV CARGO_TERM_COLOR=always \
    RUSTFLAGS="-C opt-level=z -C strip=symbols"

RUN cargo build --release --locked -p server -p cli \
    && strip target/release/monots-server target/release/monots

# Scratch stage whose only purpose is exporting binaries via buildx --output.
FROM scratch AS export
COPY --from=builder /build/target/release/monots-server /monots-server
COPY --from=builder /build/target/release/monots /monots

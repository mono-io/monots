# Packaging for architectures without an official `rust` image tag
# (e.g. linux/riscv64). Installs rustup inside Debian for the build
# platform provided by `docker buildx --platform …`.
#
# Use Debian trixie (not bookworm): official `debian:bookworm` has no
# riscv64 variant, so Buildx fails immediately with "no match for platform".
#
# Cargo caches: same BuildKit mount + GHA cache-to pattern as Dockerfile.package.

ARG DEBIAN_VERSION=trixie
ARG RUST_VERSION=1.94.1

FROM debian:${DEBIAN_VERSION} AS builder

ARG RUST_VERSION
ARG TARGETARCH
ARG TARGETVARIANT

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        build-essential \
        cmake \
        pkg-config \
        libssl-dev \
        libsasl2-dev \
        libcurl4-openssl-dev \
        protobuf-compiler \
        zip \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH \
    RUST_VERSION=${RUST_VERSION}

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain "${RUST_VERSION}" --profile minimal \
    && rustc -V && cargo -V

WORKDIR /build
COPY . .

ENV CARGO_TERM_COLOR=always \
    RUSTFLAGS="-C opt-level=z -C strip=symbols"

RUN --mount=type=cache,id=monots-cargo-registry-${TARGETARCH}${TARGETVARIANT},target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=monots-cargo-git-${TARGETARCH}${TARGETVARIANT},target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=monots-cargo-target-${TARGETARCH}${TARGETVARIANT},target=/build/target,sharing=locked \
    mkdir -p /out \
    && cargo build --release --locked -p server -p cli \
    && strip target/release/monots-server target/release/monots \
    && cp target/release/monots-server target/release/monots /out/

FROM scratch AS export
COPY --from=builder /out/monots-server /monots-server
COPY --from=builder /out/monots /monots
